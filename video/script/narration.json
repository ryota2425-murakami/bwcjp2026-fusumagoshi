    },
    {
      "id": "g11",
      "persona": "grandma",
      "scene": "s03",
      "text": "元気よぉ。大丈夫だから。",
      "fx": "phone"
    },
    {
      "id": "k01",
      "persona": "kenta",
      "scene": "s12",
      "text": "もしもし、ばあちゃん？膝の具合どう？今度、一緒に温泉行こうか。",
      "fx": "phone"
    },
    {
      "id": "g01",
